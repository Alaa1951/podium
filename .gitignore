# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
# Play service-account keys must remain outside the repository.
play-api-service-account.json
*-service-account.json
*.p12
*.p8
*.mobileprovision
*.csr
*.cer

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client is generated from the schema
/src/generated/

# database dumps are operational data, not source
/db-backups/

# development server log
dev-server.log

# deployment package output
/dist-hostinger/
/release/
/backups/
node_modules.zip

# Local mobile test fixtures, traces and screenshots
.mobile-qa/

# Official bridge runtime is copied by mobile:sync
capacitor-web/capacitor.js

# Headless browser diagnostics
debug.log

# Scratch left by local QA runs — evidence scripts and one-off probes. Kept on
# the machine that made them, never committed.
.tmp-qa/
.tmp-*
