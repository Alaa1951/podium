// PODIUM — BFT MENA leaderboard system.
//
// THE SHAPE OF THE THING, in one paragraph. PODIUM is a competition. People
// register in PAIRS and pay; a paid pair is a TEAM. Teams are dealt into WAVES
// because the floor only holds so many at once, and a wave is run against a
// clock. While a wave is on the floor its teams' SCORES are entered, zone by
// zone. A team's total is derived from its raw entries and the SERIES' own
// zone definitions — never stored — so correcting a formula re-scores the
// whole field at once.
//
//   Series ──< Wave ──< Team ──< Competitor ×2
//                        │
//                        └── Score ──< ZoneEntry
//   Series ──< Zone ──< ZoneInput      the scoring definition itself
//   Series >──< Studio                 who is taking part
//
// A SERIES IS THE COMPETITION. There is no level above or below it: "PODIUM
// Series 2" is the thing that has a date, a venue, a field, a running order
// and a board. An intermediate "event"/"round" table existed briefly and was
// removed — it added a level nobody used, and "round" already means something
// in this sport (a round of kettlebell swings), so the word was taken.
//
// A TEAM IS A REGISTRATION. There is no separate intake table: the row that
// arrives from the registration form, carrying its payment, is the same row
// that later gets a wave and a score. One record, several views of it.
//
// Two words that are NOT the same thing, and were conflated once:
//   REGISTERED   paid and entered into a PODIUM event  → Team.paymentStatus
//   MEMBER       holds a BFT studio membership         → Competitor.studioId
// A registered competitor may be a member of no studio at all.
//
// The auth/security half (User, OtpChallenge, TrustedDevice, LoginEvent,
// AuthToken) is independent of all of it. A User is somebody who SIGNS IN —
// BFT MENA staff, or studio staff. Competitors are data, not accounts, until
// BFT MENA decides to hand them one.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Explicit .ts specifiers so plain `node` (type stripping) can resolve the
  // generated files — the seed script runs outside the bundler.
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Access control
// ─────────────────────────────────────────────────────────────────────────────

/// The ACCOUNT TYPE: who the person is. It decides whose data the account can
/// reach (all of it, one studio's, one team's) and which roles it may hold.
/// What the account may DO comes from its roles (AccessRole) — see
/// src/lib/permissions/.
enum Role {
  admin // BFT MENA — Full access. Passes every check.
  staff // BFT MENA — Partial access. Exactly what their roles grant.
  studio // scoped to its own studio's teams
  // Scoped to their own team. Called "competitor", never "member": membership
  // is a BFT studio relationship and half the competitors do not have one.
  competitor
  organiser // event staff: organisers, judges, volunteers, coaches
}

/// Who may give a role to somebody. `bft_studio` roles can also be handed out
/// by a studio to its own people; such a role can never carry a BFT-only
/// permission (enforced when the role is saved).
enum RoleAssigner {
  bft
  bft_studio
}

/// Whether BFT MENA (or the chosen studio) has accepted a sign-up. Accounts
/// created any other way — invited, or through a paid registration — start
/// approved. Until then an account sees the general pages only.
enum ApprovalStatus {
  pending
  approved
  rejected
}

enum UserStatus {
  invited // created by an admin/studio, has not set a password yet
  active
  disabled
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  name                 String?
  role                 Role       @default(competitor)
  /// Per-person exceptions on top of the account's roles:
  /// `{ "grant": string[], "deny": string[] }`. A deny ("lock") always wins.
  permissionOverrides  Json?
  /// Bumped on every change to this person's roles or overrides. The editor
  /// sends back the value it loaded, and a stale save is refused.
  permissionsUpdatedAt DateTime?
  status               UserStatus @default(invited)

  // ── Sign-up and approval ─────────────────────────────────────────────────
  approvalStatus      ApprovalStatus @default(approved)
  approvedAt          DateTime?
  /// Who decided — kept as an id (the audit log carries the rest).
  approvedById        String?
  rejectionReason     String?
  phone               String?
  /// Set for a self-service sign-up: "athlete" or "organiser".
  signupType          String?
  signupAt            DateTime?
  /// What they asked to be: athlete · organiser · judge · volunteer · coach · gym-studio.
  requestedRoleKey    String?
  /// The gym they chose at sign-up — it routes the request to that studio.
  requestedStudioId   String?
  requestedStudio     Studio?        @relation("RequestedStudio", fields: [requestedStudioId], references: [id], onDelete: SetNull)
  /// Legacy first-signup choice. Active memberships live in SeriesParticipant.
  requestedSeriesId   String?
  requestedSeries     Series?        @relation("RequestedSeries", fields: [requestedSeriesId], references: [id], onDelete: SetNull)
  /// A Gym/Studio request: the gym to create or link on approval.
  requestedStudioName String?
  requestedCity       String?
  passwordHash        String?
  emailVerified       DateTime?
  locale              String         @default("en")

  // A studio user manages this studio; a competitor competes under it.
  studioId String?
  studio   Studio? @relation("StudioUsers", fields: [studioId], references: [id], onDelete: SetNull)

  forceOtpNextLogin Boolean   @default(false)
  lastLoginAt       DateTime?
  lastIp            String?

  /// Soft delete — "removed from the platform". An archived account cannot sign
  /// in and appears only in the users screen's archived filter, from which it
  /// can be restored. Nothing is hard-deleted: their audits, invitations and
  /// competitor links stay answerable.
  archivedAt DateTime?

  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts                Account[]
  otpChallenges           OtpChallenge[]
  trustedDevices          TrustedDevice[]
  loginEvents             LoginEvent[]
  authTokens              AuthToken[]
  competitors             Competitor[]
  submittedScores         Score[]            @relation("ScoreSubmittedBy")
  confirmedPayments       Team[]             @relation("PaymentConfirmedBy")
  scoreAudits             ScoreAudit[]
  adminAudits             AdminAuditLog[]    @relation("AuditActor")
  zoneStaff               ZoneStaff[]        @relation("ZoneStaffMember")
  zoneStaffAssigned       ZoneStaff[]        @relation("ZoneStaffAssignedBy")
  zoneScoresSubmitted     ZoneScore[]        @relation("ZoneScoreSubmittedBy")
  accessRoles             UserAccessRole[]   @relation("UserAccessRoles")
  athleteProfile          AthleteProfile?    @relation("AthleteProfileOwner")
  seriesParticipants      SeriesParticipant[] @relation("ParticipantUser")
  seriesPartners          SeriesParticipant[] @relation("ParticipantPartner")
  partneredProfiles       AthleteProfile[]   @relation("AthletePartner")
  partnerRequestsSent     PartnerRequest[]   @relation("PartnerRequestFrom")
  partnerRequestsReceived PartnerRequest[]   @relation("PartnerRequestTo")
  assignedAccessRoles     UserAccessRole[]   @relation("AccessRoleAssignedBy")
  notificationsCreated    Notification[]     @relation("NotificationCreator")
  notificationReads       NotificationRead[]
  portraitUploads         PortraitJob[]      @relation("PortraitUploadedBy")
  waveChangeRequests      WaveChangeRequest[] @relation("WaveChangeRequester")
  waveChangeDecisions     WaveChangeRequest[] @relation("WaveChangeReviewer")

  @@index([studioId])
  @@index([role])
  @@index([createdById])
  @@index([approvalStatus])
  @@index([requestedStudioId])
  @@index([requestedSeriesId])
}

/// An athlete's own details, captured at sign-up: who they are as a
/// competitor, and either their partner or that they are looking for one.
/// "Looking for a partner" is indexed by level and category, for pairing.
model AthleteProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("AthleteProfileOwner", fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth DateTime?
  /// "m" | "f". The form calls this GENDER; the column keeps the older name
  /// because LoadStandard is keyed on [division, sex] and renaming it would
  /// move the prescribed-loads table for no gain.
  sex         String?
  /// The level they compete at (Rookie / Open / Pro).
  division    Division?
  /// The category they want to enter (Womens / Mens / Mixed).
  category    Category?
  /// The shirt they asked for. Ordering them is the reason it is collected.
  shirtSize   ShirtSize?
  /// BFT studio membership as the athlete states it at sign-up — not the same
  /// thing as the studio that owns their entry (that is `User.studioId`).
  bftMember   Boolean    @default(false)

  lookingForPartner Boolean @default(false)

  /// What the pair want to be called. Asked for only once a partner is named:
  /// somebody still looking has nobody to be a team with yet, and the name is
  /// settled when the studio pairs them.
  teamName String?

  /// The partner, once both sides have an account and are linked.
  partnerUserId      String?
  partner            User?      @relation("AthletePartner", fields: [partnerUserId], references: [id], onDelete: SetNull)
  partnerName        String?
  partnerEmail       String?
  partnerPhone       String?
  partnerDateOfBirth DateTime?
  /// The partner's own details, as given by whoever registered the pair.
  partnerSex         String?
  partnerShirtSize   ShirtSize?
  partnerBftMember   Boolean    @default(false)
  partnerLinkedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lookingForPartner, division, category])
  @@index([partnerEmail])
  @@index([partnerUserId])
}

/// How a partner request ended. `cancelled` is the system's own answer: one of
/// the two got a partner elsewhere while this was still open.
enum PartnerRequestStatus {
  pending
  accepted
  declined
  withdrawn
  cancelled
}

/// ONE ATHLETE ASKING ANOTHER TO BE THEIR PARTNER.
///
/// The asking happens in the app and the answer is the other athlete's alone.
/// Accepting is what links the two — nothing else here writes a partnership.
model PartnerRequest {
  id         String @id @default(cuid())
  /// Null only for legacy requests whose competition could not be proven.
  seriesId   String?
  series     Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  fromUserId String
  toUserId   String
  from       User   @relation("PartnerRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User   @relation("PartnerRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  status PartnerRequestStatus @default(pending)

  /// The two ids sorted and joined with ":" — symmetric, so a pair's whole
  /// history reads the same whichever way round the asking went.
  pairKey     String  @db.VarChar(191)
  /// The same key while the request is OPEN, null once it is answered. The
  /// unique index on it IS the "one open request per pair" rule: nulls do not
  /// collide, so answered rows pile up freely while only one can be open —
  /// and A cannot ask B while B is already asking A.
  openPairKey String? @db.VarChar(191)

  /// What each of them was when the request went out. Kept so somebody who
  /// changes level afterwards does not silently re-bracket a pending ask.
  division   Division?
  category   Category?
  toDivision Division?
  toCategory Category?

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([seriesId, openPairKey])
  @@index([seriesId, status])
  @@index([toUserId, status, createdAt])
  @@index([fromUserId, status, createdAt])
  @@index([pairKey, createdAt])
}

enum NotificationAudience {
  all
  role
  studio
}

/// Generic in-app announcements. Only the server decides the audience scope.
model Notification {
  id               String               @id @default(cuid())
  title            String               @db.VarChar(160)
  body             String               @db.Text
  audience         NotificationAudience
  audienceRole     Role?
  audienceStudioId String?
  audienceStudio   Studio?              @relation(fields: [audienceStudioId], references: [id], onDelete: Cascade)
  createdBy        String
  creator          User                 @relation("NotificationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())
  reads            NotificationRead[]

  @@index([audience, createdAt])
  @@index([audienceRole, createdAt])
  @@index([audienceStudioId, createdAt])
  @@index([createdBy, createdAt])
}

/// Read receipts are per account and idempotent across devices and shells.
model NotificationRead {
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
}

// OAuth links (Google sign-in). Kept separate so a user may hold both a
// password and a federated identity for the same invited email.
model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum OtpPurpose {
  login
  activate
  reset
}

model OtpChallenge {
  id                String     @id @default(cuid())
  userId            String
  codeHash          String // HMAC-SHA256, never the code itself
  purpose           OtpPurpose
  expiresAt         DateTime
  attempts          Int        @default(0)
  consumedAt        DateTime?
  deviceFingerprint String?
  ip                String?
  createdAt         DateTime   @default(now())
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
}

enum TokenPurpose {
  invite // first password, sent when an admin/studio creates the account
  reset // forgotten password
}

model AuthToken {
  id        String       @id @default(cuid())
  userId    String
  tokenHash String // HMAC-SHA256 of the random token in the emailed link
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([tokenHash])
}

model TrustedDevice {
  id                String    @id @default(cuid())
  userId            String
  deviceFingerprint String // HMAC of the raw client fingerprint
  deviceLabel       String?
  browser           String?
  os                String?
  deviceType        String?
  firstSeenAt       DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  trustCreatedAt    DateTime  @default(now())
  trustExpiresAt    DateTime
  isTrusted         Boolean   @default(false)
  isRevoked         Boolean   @default(false)
  revokedAt         DateTime?
  revokeReason      String?
  lastIp            String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint])
  @@index([userId])
}

/**
 * Every privileged act, kept apart from the score audit: who did what, to whom,
 * and when. A score correction writes to both — ScoreAudit carries the numbers,
 * this carries the authority behind the change.
 */
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actor       User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action      String // account.invite | account.disable | score.unlock | …
  targetType  String // user | team | event | studio
  targetId    String
  targetLabel String?
  detail      String?  @db.Text
  ip          String?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action])
}

model LoginEvent {
  id                String   @id @default(cuid())
  userId            String
  eventType         String // LOGIN_SUCCESS | LOGIN_FAILED | OTP_SENT | OTP_VERIFIED | OTP_FAILED | TRUST_CREATED
  deviceFingerprint String?
  browser           String?
  os                String?
  ip                String?
  isTrustedDevice   Boolean  @default(false)
  isSuspicious      Boolean  @default(false)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventType, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Competition
// ─────────────────────────────────────────────────────────────────────────────

/// Who is competing. BFT MENA's registration form calls this Category, and
/// the system follows the form rather than the other way round.
enum Category {
  Womens
  Mens
  Mixed
}

/// The level they compete at. The form calls this Division.
enum Division {
  Rookie
  Open
  Pro
}

/// The event shirt each competitor asked for. A fixed list rather than free
/// text, because the whole point of collecting it is to count how many of
/// each to order.
enum ShirtSize {
  XS
  S
  M
  L
  XL
  XXL
}

enum SeriesStatus {
  scheduled
  live
  final
}

/// Where a registration's money stands. Only `paid` reaches the board.
enum PaymentStatus {
  pending // registered, money not confirmed
  paid // confirmed, by the payment integration or by hand at the door
  refunded
}

/// How a registration reached us. Kept so a figure on a report can always be
/// traced back to where it came from.
enum RegistrationSource {
  ghl // the CRM registration form
  manual // typed in by BFT MENA — a walk-up, or a correction
  seed // demo data
  /// The pair signed themselves up and were entered on approval. Not `manual`:
  /// nobody at BFT MENA typed this in, and a reconciler reading the export
  /// needs to be able to tell the two apart.
  signup
}

enum ScoreStatus {
  draft
  submitted
}

// A managed list, never a string on the team record — studios are added over
// time and a team's membership is a foreign key everywhere.
model Studio {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]         @relation("StudioUsers")
  signupRequests User[]         @relation("RequestedStudio")
  teams          Team[]
  competitors    Competitor[]
  notifications  Notification[]
  /// The competitions this studio is taking part in.
  series         SeriesStudio[]
}

/// THE COMPETITION. One row is one PODIUM: its date, its field, its running
/// order, its scoring definition, its board.
model Series {
  id       String  @id @default(cuid())
  name     String
  /// Short, URL-safe, stable — so a link to a series survives a rename.
  slug     String  @unique
  isActive Boolean @default(true)
  /// A rehearsal uses the same accounts but never grants real payment/approval.
  isTraining Boolean @default(false)
  /// One-time rehearsal provenance; copying again requires a deliberate new target.
  trainingSourceId String?
  trainingCopiedAt DateTime?

  competitionDate DateTime
  venue           String       @default("All studios")
  status          SeriesStatus @default(scheduled)

  // Event-day configuration — held as data, never in code, so a different
  // finisher length or wave size does not require a release.
  firstWaveTime    String    @default("09:00") // HH:mm
  /// Spacing between estimated starts, separate from the full floor duration.
  waveIntervalMinutes Int   @default(20)
  /// The whole wave, derived: zones × work + (zones − 1) × break. Kept on the
  /// row (and stamped onto each wave) so every clock reads one number.
  waveMinutes      Int       @default(20)
  /// At most nine — one team per station.
  waveCapacity     Int       @default(9)
  /// Work time in each zone, and the changeover between zones (none after the
  /// last). One START press runs the whole rotation — see src/lib/floor.ts.
  zoneWorkMinutes  Int       @default(15)
  zoneBreakMinutes Int       @default(5)
  boardOpensAt     DateTime? // live board unlocks at this instant

  // ── What a studio may do here ────────────────────────────────────────────
  /// Whether studio accounts may ENTER scores for their own teams in this
  /// competition. Off by default: score entry stays with BFT MENA unless it
  /// is deliberately opened.
  studiosMayEnterScores  Boolean @default(false)
  /// How many times a studio may write a team's score in total.
  /// The BFT manual is explicit that a saved score is final, so the default is
  /// 0 further writes: a studio that enters a result cannot change it, and any
  /// correction comes from BFT MENA.
  studioScoreCorrections Int     @default(0)

  // ── What a member may do here ────────────────────────────────────────────
  /// How many hours before the competition a member may still correct their
  /// own team (names and emails on either seat). 0 closes at the start time
  /// itself; the default is the rule of thumb this launched with: one day.
  teamEditCloseHours Int @default(24)

  /// Whether this competition is offered on the public sign-up form.
  ///
  /// Off by default, and deliberately: that form is open to the internet, so
  /// nothing appears on it until somebody decides it should. A competition
  /// being `scheduled` is not the same as being ready to advertise.
  signupOpen Boolean @default(false)

  // ── Deadlines, from the Series 1 manual's key dates ───────────────────────
  /// After this, no team may be registered, edited or removed by a studio.
  registrationClosesAt DateTime?
  /// "All registrations within the studio dashboard are final" — the manual's
  /// own wording. A date the studio is told, not a second lock: the lock is
  /// registrationClosesAt above.
  registrationsFinalAt DateTime?
  /// After this, no studio may enter or change a score.
  scoreEntryClosesAt   DateTime?
  /// When the full results stop being competitor-only and become public.
  resultsPublicAt      DateTime?
  /// "Announcement of International PODIUM Champions" — after the region's own
  /// results, the international placings land. Shown as a date to look forward
  /// to; nothing in the system unlocks on it.
  championsAnnouncedAt DateTime?

  // ── What the board shows ─────────────────────────────────────────────────
  /// BFT International's board lists the two competitors; MENA may prefer the
  /// registered team name, or both. Neither is hard-coded.
  showTeamName        Boolean @default(true)
  showCompetitorNames Boolean @default(true)
  showStudioColumn    Boolean @default(true)
  /// The sponsor rail on the wall board and published results. Off means the
  /// screens carry only the event's own branding — no rail, no placeholders.
  sponsorsEnabled     Boolean @default(true)

  /// Soft delete for a competition that was created by mistake and never ran.
  /// Only a scheduled event can reach this state — a live or finished one is
  /// part of the record and can never be removed. Null means a live event.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// How a score becomes points, here. Series 2 may test entirely different
  /// movements from Series 1 and is not required to have four zones.
  zones          Zone[]
  waves          Wave[]
  zoneStaff      ZoneStaff[]
  teams          Team[]
  sponsors       Sponsor[]
  /// The studios taking part. A studio in the directory but not in this list
  /// is simply not in this competition.
  studios        SeriesStudio[]
  /// Athletes who chose this competition when they signed up, before anybody
  /// has entered them in a team.
  signupRequests User[]         @relation("RequestedSeries")
  crmIntakes     CrmIntake[]
  participants   SeriesParticipant[]
  partnerRequests PartnerRequest[]
  waveChangeRequests WaveChangeRequest[]
  crmRegistrationMerges CrmRegistrationMerge[]

  @@index([status])
  @@index([competitionDate])
}

/// One account's participation in one competition, including before a team exists.
/// Identity remains on User/AthleteProfile; partnering and entry choices live here.
model SeriesParticipant {
  id       String @id @default(cuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  userId   String
  user     User @relation("ParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  archivedAt DateTime?
  signedUpAt DateTime @default(now())
  division Division?
  category Category?
  shirtSize ShirtSize?
  bftMember Boolean @default(false)
  lookingForPartner Boolean @default(true)
  teamName String?
  partnerUserId String?
  partner User? @relation("ParticipantPartner", fields: [partnerUserId], references: [id], onDelete: SetNull)
  partnerName String?
  partnerEmail String?
  partnerPhone String?
  partnerDateOfBirth DateTime?
  partnerSex String?
  partnerShirtSize ShirtSize?
  partnerBftMember Boolean @default(false)
  partnerLinkedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, userId])
  @@index([userId, archivedAt])
  @@index([seriesId, lookingForPartner, division, category])
  @@index([seriesId, partnerEmail])
  @@index([partnerUserId])
}

/// A studio taking part in a competition.
///
/// Deliberately thin: being in this list is what lets that studio's people
/// register their teams and follow their own entries. What they may DO is a
/// setting on the Series, not on each studio, because the rule is the same
/// for everybody in one competition.
model SeriesStudio {
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([seriesId, studioId])
  @@index([studioId])
}

// ─────────────────────────────────────────────────────────────────────────────
// The scoring definition — data, not code
// ─────────────────────────────────────────────────────────────────────────────

/// One station on the floor. Its points are the sum of its inputs' points.
model Zone {
  id       String @id @default(cuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  /// 1, 2, 3 … — both the running order and the Z1/Z2/Z3 label on the board.
  number Int
  /// "Strength", "Conditioning" — what the operator and the board call it.
  name   String

  inputs ZoneInput[]
  staff  ZoneStaff[]
  scores ZoneScore[]

  @@unique([seriesId, number])
}

/// One measured thing inside a zone, and what a unit of it is worth.
///
/// Points are `value × multiplyBy ÷ divideBy`, held as two whole numbers
/// rather than one decimal so the arithmetic is exact and so the settings
/// screen can ask the question the way a person asks it: "times what, over
/// what". Every Series 1 formula is expressible this way and none of them
/// needed a special case:
///
///   deadlift reps × 10 ÷ 1      bench reps    × 10 ÷ 1
///   rower metres  ×  1 ÷ 100    minutes left  × 10 ÷ 1
///   kettlebell    × 10 ÷ 1      seconds left  ×  1 ÷ 10
/// How a movement's field is presented. `number` is a plain whole number;
/// `minutes` and `seconds` are the two halves of one MM:SS control.
enum ZoneInputMode {
  number
  minutes
  seconds
}

model ZoneInput {
  id     String @id @default(cuid())
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  position Int
  /// "Deadlift reps" — the label on the score-entry field.
  label    String
  /// "reps", "m", "rounds", "min", "sec" — shown next to the field.
  unit     String @default("")

  multiplyBy Int @default(1)
  divideBy   Int @default(1)

  /// Highest accepted value, where one exists — 59 for seconds, the finisher
  /// cap for minutes. Null means unbounded.
  maxValue Int?

  /// How the field is DRAWN, which is a separate question from what it is
  /// WORTH. The BFT manual's score sheet has one MM:SS box for the finisher,
  /// so a `minutes` input and the `seconds` input after it are presented as a
  /// single masked control — while the engine still stores and scores them as
  /// two whole numbers with their own factors.
  ///
  /// Declared rather than guessed: reading it off the unit string would break
  /// the moment a series labels a field in Arabic.
  inputMode ZoneInputMode @default(number)

  entries ZoneEntry[]

  @@unique([zoneId, position])
}

/// A sponsor logo on one event's wall board and published results.
///
/// The artwork lives in the database as base64 rather than on disk: `public/`
/// is baked into the container image at build time, so a file uploaded at
/// runtime would not survive a redeploy — and this way a database backup
/// carries the logos with everything else. Served back through
/// `/api/series/[series]/sponsors/[id]/logo`, which any screen may read
/// (wall boards and public results are exactly where sponsors appear).
model Sponsor {
  id       String @id @default(cuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  /// "Rogue Fitness" — the accessible name when the logo renders.
  alt String

  /// Order across the sponsor rail, 0-based like every other position here.
  position Int

  /// base64 of the artwork, and what it decodes to. Limited to images.
  imageB64 String @db.MediumText
  mimeType String

  @@unique([seriesId, position])
}

enum WaveStatus {
  pending
  running
  complete
}

/**
 * One wave on the floor.
 * Its own capacity, its own length and its own clock, so the schedule is data
 * rather than arithmetic — and because each carries its own status, several
 * can be `running` at the same time. The board rotates through whichever are
 * running rather than assuming there is exactly one.
 */
model Wave {
  id       String @id @default(cuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  number          Int
  /// Scheduled start, as HH:mm on the event day.
  startTime       String @default("09:00")
  /// How long this wave runs. Defaults from the event, overridable per wave.
  durationMinutes Int    @default(20)
  /// How many teams belong on the floor for it.
  capacity        Int    @default(9)

  status    WaveStatus @default(pending)
  /// Set when an operator presses START; the clock counts from here.
  startedAt DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]

  @@unique([seriesId, number])
  @@index([seriesId, status])
}

enum ZoneStaffPosition {
  leader // one per zone: places judges on stations, scores any station
  judge // scores the team on their station
  reserve // same as a judge; a label for organising people
}

/// Who works a zone, for a whole competition — access is per ZONE, not per
/// wave, because several waves pass through each zone. A judge's station is
/// set by the zone's leader; null means "not placed yet".
model ZoneStaff {
  id       String            @id @default(cuid())
  seriesId String
  series   Series            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  zoneId   String
  zone     Zone              @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  userId   String
  user     User              @relation("ZoneStaffMember", fields: [userId], references: [id], onDelete: Cascade)
  position ZoneStaffPosition @default(judge)
  /// 1–9. Several people may share one (a warning, not an error).
  station  Int?

  assignedById String?
  assignedBy   User?   @relation("ZoneStaffAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, userId])
  @@index([seriesId])
  @@index([userId])
}

/// A TEAM IS A REGISTRATION.
///
/// The row arrives when a pair registers and pays, and the same row is later
/// dealt into a wave and scored. Keeping the intake as a separate table would
/// mean two records that have to be kept in step, and a question — "is this
/// team registered?" — that could have two answers.
model Team {
  id       String @id @default(cuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  /// Soft delete. Set when a registration is withdrawn or removed before the
  /// day: every board, list and report stops showing it, but the row — and the
  /// money and score history behind it — survives and can be restored. Null
  /// means a live registration.
  archivedAt DateTime?

  /// On the waiting list: entered after registration closed, so it holds a
  /// place only once somebody admits it. Null means a place in the field.
  ///
  /// A FACT, not a status — like `archivedAt` and `paidAt` beside it. The one
  /// word a team is shown by stays derived (team-status.ts), so this cannot
  /// drift out of step with what is on screen.
  ///
  /// Deliberately independent of payment. Money can arrive from somebody on
  /// the waiting list at any time, and it must not buy them a place: every
  /// gate that reads `paid` reads this too, through `isCompeting`.
  waitlistedAt DateTime?

  number   Int
  /// Free text, editable at any time — by BFT MENA, by the studio, or by the
  /// registration integration. When a pair registers without choosing one,
  /// it defaults to the first competitor's name; it is never left blank.
  name     String
  category Category
  division Division

  // ── Registration and payment ───────────────────────────────────────────
  /// Only a paid team appears on the board. Everything else — the roster, the
  /// wave, the reports — still counts it, which is the point of storing the
  /// state rather than deleting the row.
  paymentStatus PaymentStatus      @default(pending)
  source        RegistrationSource @default(manual)
  registeredAt  DateTime           @default(now())
  paidAt        DateTime?
  /// Minor units (fils/cents), so no amount is ever a float.
  amountMinor   Int?
  currency      String             @default("QAR")
  /// The Glofox billing number, from the payment integration or typed in.
  billingNumber String?
  /// Who confirmed a payment taken at the door, and when.
  paymentNote   String?
  confirmedById String?
  confirmedBy   User?              @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  /// The CRM submission this came from, and its payload exactly as received —
  /// so a disputed registration can be read back as it arrived.
  externalId    String?
  rawPayload    Json?
  /// Set when the pair checks in on the day. "Registered" and "turned up" are
  /// different numbers and the reports need both.
  attendedAt    DateTime?

  /// Kept as a plain number so a team always has a wave, even before the
  /// schedule is built; `waveId` is the link once it is.
  wave    Int     @default(1)
  waveId  String?
  waveRef Wave?   @relation(fields: [waveId], references: [id], onDelete: SetNull)
  /// The station (1–9) this team stands on in every zone of its wave.
  station Int?

  // The studio that registered the team — the scope key for studio accounts.
  studioId String?
  studio   Studio? @relation(fields: [studioId], references: [id], onDelete: SetNull)

  // Database-enforced edit budget: a studio submits once, then edits once.
  scoreEdits Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The composite portrait of the pair, as a path THIS app serves — the same
  /// contract as `Competitor.photoPath`. Null until one is generated.
  groupPortraitPath String?

  competitors  Competitor[]
  score        Score?
  portraitJobs PortraitJob[]
  portraits    TeamPortrait[]
  waveChangeRequests WaveChangeRequest[]
  crmRegistrationMerges CrmRegistrationMerge[]

  @@unique([seriesId, number])
  @@unique([seriesId, externalId])
  @@unique([waveId, station])
  @@index([seriesId, category, division])
  @@index([seriesId, paymentStatus])
  @@index([seriesId, waitlistedAt])
  @@index([studioId])
  @@index([waveId])
}

/// One of the two people on a team — a person, with the details the
/// registration form actually collects, not just a name on a roster.
enum WaveTimePreference {
  morning
  midday
  evening
}

enum WaveChangeStatus {
  pending
  approved
  rejected
}

model WaveChangeRequest {
  id String @id @default(cuid())
  seriesId String
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy User @relation("WaveChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  preference WaveTimePreference
  note String? @db.VarChar(1000)
  status WaveChangeStatus @default(pending)
  /// teamId while pending; NULL after a decision. MySQL permits multiple NULLs.
  openTeamId String? @unique
  /// Snapshots survive schedule rebuilding and wave deletion.
  fromWaveNumber Int
  fromStartTime String
  toWaveNumber Int?
  toStartTime String?
  reviewedById String?
  reviewedBy User? @relation("WaveChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  reviewedAt DateTime?

  @@index([seriesId, status, createdAt])
  @@index([teamId, createdAt])
  @@index([requestedById])
  @@index([reviewedById])
}

model Competitor {
  id       String @id @default(cuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  position Int // 1 = the registering competitor, 2 = their partner

  fullName    String
  phone       String?
  email       String?
  dateOfBirth DateTime?
  /// The shirt to order for this person, and whether they said they are a BFT
  /// member. Carried from the registration so a roster export can be ordered
  /// from without chasing accounts that may not exist.
  shirtSize   ShirtSize?
  bftMember   Boolean    @default(false)

  /// The portrait shown on the screens over the rigs, as a path THIS app
  /// serves. NULL means the shared default is used, which is every seat today.
  ///
  /// On the SEAT, not on the account: a station screen shows the team standing
  /// on it, and a seat exists whether or not that person ever signs in
  /// (`userId` below is nullable).
  ///
  /// A PATH, never a URL to somewhere else. Nothing in this app fetches a
  /// portrait from a third party, and a column that accepted a foreign URL is
  /// how that would begin by accident.
  photoPath String?

  /// BFT STUDIO MEMBERSHIP, and nothing to do with being registered. Null
  /// means this person is not a member of any studio — which is allowed, and
  /// common, and is a figure the reports are asked for.
  studioId String?
  studio   Studio? @relation(fields: [studioId], references: [id], onDelete: SetNull)

  // Linked if and when this person is given an account under the same name.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Normalised name (lowercase, punctuation stripped) so a search, or a new
  /// account, can be matched to an existing registration.
  normalizedName String

  portraitJobs PortraitJob[]
  portraits    CompetitorPortrait[]

  @@unique([teamId, position])
  @@index([normalizedName])
  @@index([email])
  @@index([userId])
  @@index([studioId])
}

model Score {
  id     String @id @default(cuid())
  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // The raw values live in ZoneEntry, one row per movement, because the
  // movements are defined by the series and not by this file. Seven fixed
  // columns could only ever describe Series 1.

  status        ScoreStatus @default(draft)
  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?       @relation("ScoreSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits  ScoreAudit[]
  entries ZoneEntry[]
  /// Per-zone lock. The team score is submitted when every zone is.
  zones   ZoneScore[]

  @@index([status])
}

/// One measured value: what this team did on one movement of one zone.
///
/// Its points are worked out from the ZoneInput it points at, so changing a
/// factor in the settings re-scores every team that ever recorded it.
model ZoneEntry {
  id      String    @id @default(cuid())
  scoreId String
  score   Score     @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  inputId String
  input   ZoneInput @relation(fields: [inputId], references: [id], onDelete: Cascade)

  /// Null means not yet recorded, which is not the same as zero.
  value Int?

  @@unique([scoreId, inputId])
  @@index([inputId])
}

/// One zone of one team's score, locked when its judge submits it.
///
/// Judges work per zone, so a team's score is finished zone by zone. The
/// Score row becomes `submitted` in the same transaction as its last zone;
/// after that only BFT MENA Full access can correct a zone.
model ZoneScore {
  id      String      @id @default(cuid())
  scoreId String
  score   Score       @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  zoneId  String
  zone    Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  status  ScoreStatus @default(draft)

  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?     @relation("ZoneScoreSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([scoreId, zoneId])
  @@index([zoneId])
}

model ScoreAudit {
  id       String  @id @default(cuid())
  scoreId  String
  score    Score   @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  field    String
  oldValue String?
  newValue String?
  reason   String?

  operatorId String?
  operator   User?   @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([scoreId, createdAt])
}

// Prescribed loads per category and sex, seeded from the weights sheet.
/// Prescribed loads, set by LEVEL and sex — so the key is the division
/// (Rookie/Open/Pro), not the category, which is the sex grouping itself.
model LoadStandard {
  id         String   @id @default(cuid())
  division   Division
  sex        String // "m" | "f"
  trapBar    String
  bench      String
  kettlebell String
  dumbbell   String
  wallBall   String

  @@unique([division, sex])
}

/// An ACCESS ROLE — a named, editable bundle of permission keys ("Organiser",
/// "Judge", "Gym/Studio"). A person can hold several (UserAccessRole), and
/// their permissions add up. A person holding none gets the default role for
/// their account type. BFT MENA Full access passes every check and needs no role.
model AccessRole {
  id          String  @id @default(cuid())
  /// Stable slug, unique. Used in code and seeds ("organiser").
  key         String  @unique
  name        String
  nameAr      String?
  /// What the role is for, shown on the roles screen.
  description String?

  /// The granted permission keys, from the catalog (permissions/catalog.ts).
  /// Always read through normalizeStoredPermissions, so older keys still resolve.
  permissions Json

  /// System roles ship with the product and cannot be deleted.
  isSystem Boolean @default(false)

  /// Who may hand this role out.
  assignableBy RoleAssigner @default(bft)
  /// The account types this role is meant for (a JSON array of Role values);
  /// null means any.
  accountTypes Json?
  sortOrder    Int          @default(0)

  users UserAccessRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One role held by one person. A person may hold several.
model UserAccessRole {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("UserAccessRoles", fields: [userId], references: [id], onDelete: Cascade)
  accessRoleId String
  accessRole   AccessRole @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)
  /// Who gave it, for the audit trail.
  assignedById String?
  assignedBy   User?      @relation("AccessRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@unique([userId, accessRoleId])
  @@index([accessRoleId])
  @@index([assignedById])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI PORTRAITS.
//
// An athlete uploads a photo of themselves or their partner; it is restyled by
// an image API into a competition poster portrait, and the two finished
// portraits are then combined into one team image. The result is what the
// screens over the rigs show.
//
// ONE `PortraitJob` ROW IS ONE PAID CALL. The runner claims rows the same way
// `waves.ts` starts a wave — an UPDATE guarded by the current status, never a
// lock held in memory — so a second process, or a second tick, cannot pay for
// the same job twice.
//
// THE UPLOADED ORIGINAL LIVES ONLY ON THE JOB, and only until that job ends,
// whether it ended well or badly. The finished portrait is a separate and
// permanent row, so clearing the original never blanks what is on screen. A
// photograph of somebody's face is kept for exactly as long as the thing that
// needed it, and not one step longer.
// ─────────────────────────────────────────────────────────────────────────────

enum PortraitTargetKind {
  competitor
  team
}

enum PortraitJobStatus {
  queued
  running
  succeeded
  failed
}

model PortraitJob {
  id String @id @default(cuid())

  targetKind   PortraitTargetKind
  competitorId String?
  competitor   Competitor?        @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  teamId       String?
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)

  status PortraitJobStatus @default(queued)

  /// The photo as uploaded, after `sharp` has decoded it, stripped its
  /// metadata (EXIF carries GPS) and re-encoded it. Cleared to NULL the moment
  /// this job reaches `succeeded` or `failed`.
  sourceB64  String? @db.MediumText
  sourceMime String?

  /// The disclosure was shown and accepted at this instant. Recorded from what
  /// the upload sent, never inferred from the job existing — a job without it
  /// is a bug, not a default.
  consentAt    DateTime?
  consentIp    String?
  uploadedById String?
  uploadedBy   User?     @relation("PortraitUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  /// COMPOSITE only: the two portraits this job combines, pinned when it is
  /// created. Without pinning, re-rolling one face mid-flight would produce a
  /// team image blending a new face with an old one.
  inputPortraitIdA String?
  inputPortraitIdB String?

  /// Bumped when the runner reclaims a job — a row left `running` by a crash,
  /// or a transient API failure. Bounded, so nothing retries for ever.
  retryCount Int @default(0)

  claimedAt    DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  /// Short and never sensitive: it is shown to the athlete and written to logs.
  failedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competitorPortrait CompetitorPortrait?
  teamPortrait       TeamPortrait?

  @@index([status, createdAt])
  @@index([competitorId])
  @@index([teamId])
}

/// A finished portrait. Old rows are kept: the serving URL carries this row's
/// own id, so a cached image or an open tab can never flip to another face.
model CompetitorPortrait {
  id           String      @id @default(cuid())
  competitorId String
  competitor   Competitor  @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  jobId        String      @unique
  job          PortraitJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  imageB64 String @db.MediumText
  mimeType String

  createdAt DateTime @default(now())

  @@index([competitorId, createdAt])
}

/// The pair, in one image.
model TeamPortrait {
  id     String      @id @default(cuid())
  teamId String
  team   Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  jobId  String      @unique
  job    PortraitJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  imageB64 String @db.MediumText
  mimeType String

  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}

/// THE SPEND CAP, one row per UTC day.
///
/// In the database rather than in `rate-limit.ts`, which is in memory and
/// resets on every restart — fine for throttling a login, useless as a ceiling
/// on a paid API. The claim is a guarded UPDATE, so many uploads landing in the
/// same second cannot all read "under the cap" and all proceed.
model PortraitSpendCounter {
  /// "YYYY-MM-DD" in UTC, so the key needs no timezone arithmetic in a WHERE.
  day       String   @id @db.VarChar(10)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// The state of the GoHighLevel sync. Exactly one row, id "singleton".
///
/// A SINGLE ROW rather than a table of runs, because the only questions worth
/// answering are "is a poll happening right now" and "when did one last work".
/// A history of every fifteen-minute poll would be tens of thousands of rows
/// nobody reads, and the audit log already records what each poll changed.
///
/// `running` is the claim flag: a poll takes it with a conditional updateMany
/// and runs only if that changed exactly one row — the same idiom that starts
/// a wave once. It is what stops the timer and the Sync now button from
/// working the same eighty-five records at the same time.
model CrmSyncState {
  id      String  @id @default("singleton")
  running Boolean @default(false)

  /// When the current or last poll took the claim. A poll older than the
  /// stale window is presumed dead and the claim is released — a process
  /// killed mid-poll must not lock the sync out for good.
  claimedAt     DateTime?
  lastRunAt     DateTime?
  lastSuccessAt DateTime?

  /// What the last finished poll did, for the screen and the log.
  lastCreated Int @default(0)
  lastUpdated Int @default(0)
  /// Registrations the CRM has not finished — held, not discarded.
  lastWaiting Int @default(0)
  lastSkipped Int @default(0)

  /// Redacted already by the client: a status and a short code, never a body.
  lastError String? @db.VarChar(191)

  updatedAt DateTime @updatedAt
}

/// A CRM registration that is not a team yet, and why.
///
/// WHY THIS IS NOT JUST A `Team` WITH BLANKS. `Team.category` and
/// `Team.division` are required, and fifty-three files read them: they decide
/// the bracket, the results, and — through `LoadStandard`, keyed on
/// [division, sex] — the weights a pair actually lifts on the floor. A team
/// row holding "unknown" would leak that unknown into every one of those, and
/// the leak would look like an ordinary team until somebody was handed the
/// wrong bar.
///
/// So a registration the CRM has not finished lives here instead: visible,
/// chase-able, counted, and unable to reach a bracket. The sync promotes it
/// to a real `Team` the moment the missing fields arrive, and deletes the row.
///
/// It MIRRORS the CRM rather than accumulating. A contact that stops matching
/// — because it was finished, or removed — loses its row on the next poll.
model CrmIntake {
  id       String @id @default(cuid())
  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  /// The GHL contact id. One row per contact per competition, which is the
  /// same rule `Team.externalId` carries — and for the same reason.
  externalId String @db.VarChar(191)

  /// Enough to chase somebody, because chasing them is the entire point.
  contactName String  @db.VarChar(191)
  email       String? @db.VarChar(191)
  phone       String? @db.VarChar(191)
  partnerName String? @db.VarChar(191)
  teamName    String? @db.VarChar(191)

  /// What the CRM's pipeline says right now, in its own words.
  stageName String? @db.VarChar(191)
  /// What is stopping it becoming a team — "no category and no division".
  missing   String  @db.VarChar(191)

  /// The contact exactly as it arrived, so a dispute can be read back.
  rawPayload Json?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime
  updatedAt   DateTime @updatedAt

  @@unique([seriesId, externalId])
  @@index([seriesId, missing])
}

/// An explicitly approved registration consolidation. Kept after CRM cleanup
/// so an old contact cannot create a second intake or overwrite the payer.
model CrmRegistrationMerge {
  id                  String   @id @default(cuid())
  seriesId            String
  series              Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  teamId              String
  team                Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  retiredExternalId   String   @db.VarChar(191)
  canonicalExternalId String   @db.VarChar(191)
  /// prepared pauses both sources; linked/completed suppress only the retired one.
  status              String   @default("prepared") @db.VarChar(32)
  beforeSnapshot      Json
  paymentEvidence     Json?
  reason              String   @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  completedAt         DateTime?

  @@unique([seriesId, retiredExternalId])
  @@index([seriesId, canonicalExternalId])
  @@index([teamId])
}
