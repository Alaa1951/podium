{
  "name": "pudem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node server.js",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "dev:bg": "node scripts/dev-bg.mjs",
    "otp": "node scripts/show-otp.mjs",
    "db:scenarios": "node prisma/seed-scenarios.ts",
    "verify": "npm run type-check && npm run lint && npm run test && npm run build",
    "verify:fast": "node scripts/verify.mjs --fast",
    "db:generate": "prisma generate",
    "db:migrate:status": "prisma migrate status",
    "docs:access": "node scripts/access-doc.ts",
    "package:hostinger": "node scripts/prepare-hostinger-package.mjs",
    "mobile:sync": "node scripts/mobile-sync.mjs",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "mobile:fixtures": "node scripts/mobile-fixtures.mjs",
    "test:mobile": "playwright test",
    "test:mobile:quick": "playwright test --project=chromium-390-en-dark --project=webkit-390-en-dark"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^11.0.2",
    "mariadb": "^3.5.4",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
